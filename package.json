{
  "name": "zdoda-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:local": "node scripts/dev-local.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "emulators": "firebase emulators:start --only auth,firestore,storage",
    "seed": "pnpm --filter @zdoda/functions seed",
    "deploy": "firebase deploy --only hosting,functions,firestore,storage"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@12.15.0"
}
