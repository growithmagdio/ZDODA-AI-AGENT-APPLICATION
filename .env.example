# ==============================================================================
# Zdoda Platform Environment Variables (.env.example)
# All sensitive variables must be set in your private .env file (gitignored).
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application & Networking [Phase 1]
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
WEB_APP_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000

# ------------------------------------------------------------------------------
# Security, Sessions & Encryption [Phase 1]
# ------------------------------------------------------------------------------
# 32-character random string for AES-256-GCM encryption of integration tokens
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Session cookie secret for signed session cookies
SESSION_SECRET=super-secret-session-cookie-encryption-key-min-32-chars

# ------------------------------------------------------------------------------
# Database & Cache [Phase 1]
# ------------------------------------------------------------------------------
# PostgreSQL with pgvector extension enabled
DATABASE_URL=postgresql://zdoda_user:zdoda_password@localhost:5432/zdoda_db?schema=public
# Redis for BullMQ ingestion queues, retries and rate limiting
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Email / Notification Provider [Phase 1 & Phase 6]
# Needed for: verification emails, password resets, team invites
# Mock Behavior: In development, defaults to Mailpit (http://localhost:8025)
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=mailpit # mailpit | resend | smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Zdoda Notifications <noreply@zdoda.app>"
RESEND_API_KEY=

# ------------------------------------------------------------------------------
# Object Storage Provider [Phase 3 & Phase 4]
# Needed for: knowledge file uploads (PDF/DOCX), agent avatars, widget logos
# Mock Behavior: In development, defaults to local filesystem or MinIO
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local # local | minio | s3
STORAGE_BUCKET=zdoda-uploads
STORAGE_ENDPOINT=http://localhost:9000 # MinIO endpoint if using minio
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1

# ------------------------------------------------------------------------------
# Google OAuth [Phase 1]
# Needed for: "Sign in with Google" button
# Mock Behavior: When unset, the Google sign-in button is cleanly hidden
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Stripe Payments & Billing [Phase 2]
# Needed for: Checkout sessions, subscriptions, billing portal, webhooks
# Mock Behavior: When unset, billing runs in Mock Adapter mode, showing "Demo" pills
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# LLM Providers [Phase 3]
# Needed for: Agent builder streaming test panel, RAG answers, voice agent turns
# Mock Behavior: When unset, LLMProvider falls back to scripted demo replies
# ------------------------------------------------------------------------------
LLM_PROVIDER=mock # openai | gemini | anthropic | mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# Vector Embeddings Provider [Phase 3]
# Needed for: Knowledge chunk embeddings (1536-dim) & cosine search
# Mock Behavior: When unset, uses a deterministic hash-based 1536-dim mock vector
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=mock # openai | gemini | mock

# ------------------------------------------------------------------------------
# WhatsApp Cloud API (Meta) [Phase 5]
# Needed for: Real WhatsApp inbound webhooks & outbound agent replies
# Mock Behavior: When unset, WhatsApp channel shows "Setup required" with missing fields
# ------------------------------------------------------------------------------
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# ------------------------------------------------------------------------------
# Telephony & Voice (Twilio & Voice Engine) [Phase 5]
# Needed for: Real inbound phone calls, phone number purchasing, voice streaming
# Mock Behavior: When unset, Voice channel displays "Demo" with simulated audio player
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
VOICE_ENGINE_PROVIDER=mock # deepgram | cartesia | elevenlabs | mock
