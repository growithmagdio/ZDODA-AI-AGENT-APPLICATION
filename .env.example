# ==============================================================================
# Zdoda — environment (copy to .env at the repo root; .env is gitignored)
# Browser values start with VITE_. Everything else is server-only.
# ==============================================================================

# ---- Web app (Firebase client config — safe to expose) -----------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# true = use the local Auth emulator (automatic when VITE_FIREBASE_API_KEY is empty)
VITE_USE_EMULATORS=
VITE_ENABLE_GOOGLE_SIGNIN=true
# Show the demo login hint on /login (always shown with emulators)
VITE_SHOW_DEMO_LOGIN=false

# ---- API (apps/functions) ----------------------------------------------------
WEB_APP_URL=http://localhost:5173
# Base URL embedded widgets call (defaults to WEB_APP_URL; Hosting rewrites /api)
PUBLIC_API_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5173
# 64 hex chars: openssl rand -hex 32  (required in production)
ENCRYPTION_KEY=
TRIAL_DAYS=14
MAX_SITEMAP_PAGES=50

# ---- AI providers (any one enables live answers) -----------------------------
# auto | anthropic | openai | gemini | mock
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-haiku-5-5
OPENAI_DEFAULT_MODEL=gpt-4.1-mini
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
# auto | openai | gemini | mock  (768-dim vectors; re-index after changing)
EMBEDDING_PROVIDER=auto

# ---- Stripe (empty = demo billing) -------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=

# ---- Email (empty = invites are copy-a-link) ---------------------------------
RESEND_API_KEY=
EMAIL_FROM="Zdoda <noreply@yourdomain.com>"

# ---- Local development -------------------------------------------------------
# memory = no Java needed: in-memory Firestore + local file storage + Auth emulator
LOCAL_DATA=
