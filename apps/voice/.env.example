# LiveKit Cloud (cloud.livekit.io → project → Settings → Keys) or your self-hosted server
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Where the Zdoda API lives and the shared secret it expects (same value as VOICE_WORKER_SECRET in the API)
ZDODA_API_URL=https://app.zdoda.com
VOICE_WORKER_SECRET=
# Speech-to-text
DEEPGRAM_API_KEY=
# Voices (any one)
ELEVEN_API_KEY=
CARTESIA_API_KEY=
# LLM (any one)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
