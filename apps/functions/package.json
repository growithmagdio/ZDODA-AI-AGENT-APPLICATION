{
  "name": "@zdoda/functions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/dev.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
