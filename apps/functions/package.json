    "test": "vitest run",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.6.0",
    "mammoth": "^1.13.0",
    "node-html-parser": "^7.1.0",
    "pdf-parse": "^1.1.4",
    "stripe": "^17.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^6.0.3",
    "@zdoda/shared": "workspace:*",
    "esbuild": "^0.25.12",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
