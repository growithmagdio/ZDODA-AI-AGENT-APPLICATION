// Zdoda AI Agent SaaS - Prisma Schema
// PostgreSQL 16 + pgvector

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum GlobalRole {
  USER
  SUPERADMIN
}

enum WorkspaceRole {
  OWNER
  ADMIN
  BUILDER
  AGENT
  VIEWER
}

enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum KnowledgeSourceType {
  WEBSITE
  SITEMAP
  PDF
  DOCX
  TXT
  CSV
  FAQ
  NOTE
}

enum SourceStatus {
  PENDING
  PROCESSING
  ACTIVE
  FAILED
}

enum ToolType {
  INTEGRATION
  CUSTOM_API
  MCP
  FUNCTION
}

enum ChannelType {
  WEBSITE
  WHATSAPP
  VOICE
}

enum ChannelStatus {
  LIVE
  TEST_MODE
  DEMO
  SETUP_REQUIRED
  DISABLED
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

enum MessageRole {
  USER
  ASSISTANT
  HUMAN_AGENT
  SYSTEM
}

enum UsageMetric {
  MESSAGES
  VOICE_SECONDS
  AGENTS
}

// -------------------------------------------------------------
// 1. Identity, Auth & Workspace
// -------------------------------------------------------------

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  passwordHash  String
  name          String
  avatarUrl     String?
  emailVerified Boolean      @default(false)
  role          GlobalRole   @default(USER)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sessions      Session[]
  memberships   Membership[]
  clientAccess  ClientAccess[]
  auditLogs     AuditLog[]
  notifications Notification[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Workspace {
  id                String       @id @default(cuid())
  name              String
  slug              String       @unique
  logoUrl           String?
  timezone          String       @default("UTC")
  defaultLanguage   String       @default("en")
  parentWorkspaceId String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  parentWorkspace   Workspace?   @relation("AgencyHierarchy", fields: [parentWorkspaceId], references: [id], onDelete: SetNull)
  childWorkspaces   Workspace[]  @relation("AgencyHierarchy")

  memberships       Membership[]
  clientAccessGrants ClientAccess[]
  subscription      Subscription?
  usageRecords      UsageRecord[]
  invoices          Invoice[]
  agents            Agent[]
  agentVersions     AgentVersion[]
  knowledgeSources  KnowledgeSource[]
  knowledgeChunks   KnowledgeChunk[]
  tools             Tool[]
  integrationConnections IntegrationConnection[]
  channels          Channel[]
  phoneNumbers      PhoneNumber[]
  contacts          Contact[]
  leads             Lead[]
  conversations     Conversation[]
  messages          Message[]
  callRecords       CallRecord[]
  widgetConfigs     WidgetConfig[]
  widgetVersions    WidgetVersion[]
  onboardingProgress OnboardingProgress?
  auditLogs         AuditLog[]
  notifications     Notification[]

  @@index([parentWorkspaceId])
  @@map("workspaces")
}

model Membership {
  id          String        @id @default(cuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(VIEWER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@index([userId])
  @@map("memberships")
}

model ClientAccess {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  grantedById String
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("client_access")
}

// -------------------------------------------------------------
// 2. Billing, Plans & Usage
// -------------------------------------------------------------

model Plan {
  id                String         @id @default(cuid())
  name              String
  slug              String         @unique
  description       String
  priceMonthly      Int            // in cents
  priceYearly       Int            // in cents (discounted)
  showPrice         Boolean        @default(true)
  messageLimit      Int
  voiceSecondsLimit Int
  agentLimit        Int
  featuresJson      Json           @default("[]")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  subscriptions     Subscription[]

  @@map("plans")
}

model Subscription {
  id                   String             @id @default(cuid())
  workspaceId          String             @unique
  planId               String
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(TRIALING)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  workspace            Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan                 Plan               @relation(fields: [planId], references: [id])

  @@index([workspaceId])
  @@index([planId])
  @@map("subscriptions")
}

model UsageRecord {
  id          String      @id @default(cuid())
  workspaceId String
  metric      UsageMetric
  value       Int         @default(0)
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime    @default(now())

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, metric, periodStart])
  @@map("usage_records")
}

model Invoice {
  id              String    @id @default(cuid())
  workspaceId     String
  stripeInvoiceId String?   @unique
  amount          Int       // in cents
  status          String
  date            DateTime
  pdfUrl          String?
  createdAt       DateTime  @default(now())

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("invoices")
}

// -------------------------------------------------------------
// 3. AI Agents & Configuration
// -------------------------------------------------------------

model Agent {
  id                     String           @id @default(cuid())
  workspaceId            String
  name                   String
  description            String?
  category               String           @default("General")
  personality            String?
  tone                   String?
  systemInstructions     String           @db.Text
  model                  String           @default("gpt-4o")
  temperature            Float            @default(0.7)
  language               String           @default("auto")
  welcomeMessage         String           @default("Hello! How can I help you today?")
  fallbackResponse       String           @default("I'm sorry, I couldn't find information about that. Would you like to speak to a team member?")
  escalationInstructions String?          @db.Text
  voiceEnabled           Boolean          @default(false)
  isPublished            Boolean          @default(false)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  workspace              Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions               AgentVersion[]
  agentKnowledge         AgentKnowledge[]
  agentTools             AgentTool[]
  channels               Channel[]
  phoneNumbers           PhoneNumber[]
  conversations          Conversation[]
  callRecords            CallRecord[]

  @@index([workspaceId])
  @@map("agents")
}

model AgentVersion {
  id            String    @id @default(cuid())
  agentId       String
  workspaceId   String
  versionNumber Int
  snapshotJson  Json
  publishedById String
  publishedAt   DateTime  @default(now())

  agent         Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([agentId, versionNumber])
  @@index([workspaceId])
  @@map("agent_versions")
}

model KnowledgeSource {
  id           String              @id @default(cuid())
  workspaceId  String
  name         String
  type         KnowledgeSourceType
  sourceUrl    String?
  filePath     String?
  status       SourceStatus        @default(PENDING)
  errorMessage String?
  chunkCount   Int                 @default(0)
  lastSyncedAt DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chunks       KnowledgeChunk[]
  agentLinks   AgentKnowledge[]

  @@index([workspaceId, type])
  @@map("knowledge_sources")
}

model KnowledgeChunk {
  id          String                 @id @default(cuid())
  workspaceId String
  sourceId    String
  content     String                 @db.Text
  chunkIndex  Int
  tokenCount  Int
  embedding   Unsupported("vector")?
  metadataJson Json                  @default("{}")
  createdAt   DateTime               @default(now())

  workspace   Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source      KnowledgeSource        @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([sourceId])
  @@map("knowledge_chunks")
}

model AgentKnowledge {
  id                String          @id @default(cuid())
  agentId           String
  knowledgeSourceId String
  workspaceId       String
  createdAt         DateTime        @default(now())

  agent             Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  knowledgeSource   KnowledgeSource @relation(fields: [knowledgeSourceId], references: [id], onDelete: Cascade)

  @@unique([agentId, knowledgeSourceId])
  @@index([workspaceId])
  @@map("agent_knowledge")
}

// -------------------------------------------------------------
// 4. Tools, Integrations & Channels
// -------------------------------------------------------------

model Tool {
  id          String      @id @default(cuid())
  workspaceId String
  name        String
  type        ToolType
  schemaJson  Json        // JSON Schema for tool parameters
  configJson  Json        @default("{}")
  isEnabled   Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentTools  AgentTool[]

  @@index([workspaceId])
  @@map("tools")
}

model AgentTool {
  id          String    @id @default(cuid())
  agentId     String
  toolId      String
  workspaceId String
  createdAt   DateTime  @default(now())

  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tool        Tool      @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([agentId, toolId])
  @@index([workspaceId])
  @@map("agent_tools")
}

model IntegrationConnection {
  id                String        @id @default(cuid())
  workspaceId       String
  provider          String        // 'google-calendar', 'slack', 'hubspot'
  accountName       String?
  encryptedTokens   String        @db.Text // AES-256-GCM
  status            ChannelStatus @default(SETUP_REQUIRED)
  lastHealthCheckAt DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  workspace         Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, provider])
  @@map("integration_connections")
}

model Channel {
  id                String        @id @default(cuid())
  workspaceId       String
  agentId           String?
  type              ChannelType
  isEnabled         Boolean       @default(true)
  configJson        Json          @default("{}")
  status            ChannelStatus @default(DEMO)
  lastHealthCheckAt DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  workspace         Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent             Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  widgetConfigs     WidgetConfig[]
  conversations     Conversation[]

  @@index([workspaceId, type])
  @@map("channels")
}

model PhoneNumber {
  id               String        @id @default(cuid())
  workspaceId      String
  agentId          String?
  phoneNumber      String        @unique
  friendlyName     String
  providerSid      String?
  status           ChannelStatus @default(DEMO)
  capabilitiesJson Json          @default("{\"voice\":true,\"sms\":false}")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  workspace        Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent            Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  callRecords      CallRecord[]

  @@index([workspaceId])
  @@map("phone_numbers")
}

// -------------------------------------------------------------
// 5. Widget Studio & Configurations
// -------------------------------------------------------------

model WidgetConfig {
  id                 String          @id @default(cuid())
  workspaceId        String
  channelId          String
  publicKey          String          @unique // e.g. wk_pub_...
  allowedDomains     String[]        @default(["*"])
  draftJson          Json            // WidgetConfigV1 draft
  publishedVersionId String?
  version            Int             @default(1) // Optimistic locking
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  workspace          Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel            Channel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  versions           WidgetVersion[]

  @@index([workspaceId])
  @@index([publicKey])
  @@map("widget_configs")
}

model WidgetVersion {
  id             String       @id @default(cuid())
  widgetConfigId String
  workspaceId    String
  versionNumber  Int
  configJson     Json         // Immutable WidgetConfigV1 snapshot
  publishedById  String
  publishedAt    DateTime     @default(now())

  widgetConfig   WidgetConfig @relation(fields: [widgetConfigId], references: [id], onDelete: Cascade)
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([widgetConfigId, versionNumber])
  @@index([workspaceId])
  @@map("widget_versions")
}

// -------------------------------------------------------------
// 6. Conversations, Messages, Contacts & Leads
// -------------------------------------------------------------

model Contact {
  id           String         @id @default(cuid())
  workspaceId  String
  name         String?
  email        String?
  phone        String?
  metadataJson Json           @default("{}")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads        Lead[]
  conversations Conversation[]

  @@index([workspaceId])
  @@index([workspaceId, email])
  @@index([workspaceId, phone])
  @@map("contacts")
}

model Lead {
  id             String        @id @default(cuid())
  workspaceId    String
  contactId      String
  conversationId String?
  score          Int           @default(50)
  status         LeadStatus    @default(NEW)
  summary        String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact        Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@map("leads")
}

model Conversation {
  id               String             @id @default(cuid())
  workspaceId      String
  agentId          String?
  channelId        String?
  contactId        String?
  channelType      ChannelType
  status           ConversationStatus @default(OPEN)
  leadStatus       LeadStatus         @default(NEW)
  humanTakeover    Boolean            @default(false)
  assignedToUserId String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  workspace        Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent            Agent?             @relation(fields: [agentId], references: [id], onDelete: SetNull)
  channel          Channel?           @relation(fields: [channelId], references: [id], onDelete: SetNull)
  contact          Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  messages         Message[]
  leads            Lead[]
  callRecords      CallRecord[]

  @@index([workspaceId, status])
  @@index([workspaceId, channelType])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  workspaceId    String
  role           MessageRole
  content        String       @db.Text
  metadataJson   Json         @default("{}") // citations, tokens, latency
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([workspaceId])
  @@map("messages")
}

model CallRecord {
  id              String       @id @default(cuid())
  workspaceId     String
  agentId         String?
  conversationId  String?
  phoneNumberId   String?
  durationSeconds Int          @default(0)
  recordingUrl    String?
  transcript      String?      @db.Text
  status          String       @default("completed")
  costCents       Int          @default(0)
  createdAt       DateTime     @default(now())

  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent           Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  phoneNumber     PhoneNumber? @relation(fields: [phoneNumberId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@map("call_records")
}

// -------------------------------------------------------------
// 7. System, Templates, Audit & Ops
// -------------------------------------------------------------

model Template {
  id          String   @id @default(cuid())
  title       String
  category    String
  description String
  prompt      String   @db.Text
  toolsJson   Json     @default("[]")
  icon        String   @default("bot")
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("templates")
}

model OnboardingProgress {
  id                 String    @id @default(cuid())
  workspaceId        String    @unique
  currentStep        Int       @default(1)
  completedStepsJson Json      @default("[]")
  isComplete         Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("onboarding_progress")
}

model Notification {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  title       String
  message     String
  type        String   @default("info")
  isRead      Boolean  @default(false)
  linkUrl     String?
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, isRead])
  @@map("notifications")
}

model AuditLog {
  id           String    @id @default(cuid())
  workspaceId  String
  userId       String?
  action       String    // e.g. "agent.published", "subscription.upgraded"
  resourceType String    // e.g. "Agent", "Billing"
  resourceId   String?
  detailsJson  Json      @default("{}")
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, action])
  @@index([workspaceId, createdAt])
  @@map("audit_logs")
}

model ProcessedWebhookEvent {
  id          String   @id @default(cuid())
  provider    String   // 'stripe', 'meta', 'twilio'
  eventId     String   @unique
  eventType   String
  payloadHash String
  createdAt   DateTime @default(now())

  @@index([provider, eventId])
  @@map("processed_webhook_events")
}
